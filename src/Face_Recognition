import cv2 as cv
import numpy as np
import sys
import matplotlib.pyplot as plt
import yunet
import os
import sys
import sface

#helper function to draw bounding boxes and confidence scores on the frame
def draw_faces(frame, face, name, confidence_score, recognised = False):
    #face is a 1D array with 15 elements, the first 4 elements are the bounding box coordinates (x, y, w, h) which are used to define the bounding box
    bbox = face[0:4].astype(np.int32)
    x, y, w, h = bbox
    if recognised:
        #bounding box
        cv.rectangle(frame, (x, y), (x + w, y + h), (0, 255, 0), 2)
        #confidence score
        cv.putText(frame, f"{name}: {confidence_score:.2f}", (x, y - 10), cv.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
    
    else:
        #bounding box
        cv.rectangle(frame, (x, y), (x + w, y + h), (0, 0, 255), 2)
        #confidence score
        cv.putText(frame, f"Face Detected: {face[14]:.2f} id: unknown", (x, y - 10), cv.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 2)

#Initialise webcam as input source
s = 0
if len(sys.argv) > 1:
    s = sys.argv[1]
source = cv.VideoCapture(s)

#Initialise output video window
win_name = "webcam"
cv.namedWindow(win_name, cv.WINDOW_NORMAL)

#Initialise VideoWriter object
name = 'face_detection_test'
while os.path.exists("video/" + name + str(s) + '.mp4'):
    s += 1
mp4VideoWriter = cv.VideoWriter("video/" + name + str(s) + '.mp4', cv.VideoWriter_fourcc(*'mp4v'), 30, (640, 480))

#Load face detection YuNet model using the yunet.YuNet wrapper class
YuNetDetection = yunet.YuNet("models/face_detection_yunet_2026may.onnx")

#Load face recognition SFace model using the sface.SFace wrapper class
SFaceRecognition = sface.SFace("models/face_recognition_sface_2021dec.onnx", disType=0)

#Preprocessing (provides expected input size to the model). This is done by reading a single valid frame from the webcam and using its dimensions to set the input size of the model.
if not source.isOpened():
        print("Cannot open camera")
        exit()
ret, frame = source.read()
if ret:
    w, h = frame.shape[1], frame.shape[0]
YuNetDetection.setInputSize([w, h])

players = {}    # Dictionary to store player names and their corresponding feature embeddings

#Processing loop
while cv.waitKey(1) != 27:
    #Read frame and validate
    ret, frame = source.read()
    if not ret:
        print("Can't receive frame. Exiting ...")
        break

    #Mirror the frame for convenience
    frame = cv.flip(frame, 1)

    #Run face detection
    faces = YuNetDetection.infer(frame)

    #Run face recognition and draw annotations
    for face in faces:
        #Extract feature embedding for the detected face
        feature_embedding = SFaceRecognition.infer(frame, face)

        #Initialize variables to track the best match
        best_score = -1     # used to store the highest similarity score found during comparisons with existing players. The player with the highest score is considered the best match for the detected face.
        best_player = None  # used to store the name of the player with the best match
        recognised = 0      # used to indicate if the detected face matches any existing player
        new_embedding = 0   # used to indicate if the detected face is a new embedding for an existing player. This allows the program to capture multiple embeddings for the same player (in different lighting conditions or from different angles), which can improve recognition accuracy over time.

        # Identify the best matching player
        for player in players:
            # Compare the detected face's feature embedding with each of the existing embeddings of the current player
            existing_embeddings = players[player]
            comparisons = list(map(lambda x: SFaceRecognition.match_features(feature_embedding, x), existing_embeddings))   #comparisons is a list of tuples containing the similarity score and match result for each comparison between the detected face's feature embedding and the existing embeddings of the current player.

            # Find the best match for the current player based on the highest similarity score
            score, match = max(comparisons, key=lambda p: p[0])
            if score > best_score:
                best_score = score
                best_player = player
                recognised = match
                new_embedding = not max(comparisons[:-1], key=lambda p: p[0])   # Check if the best match is a new embedding for the player (i.e., if the feature embedding is not recognised by any existing embedding). If it is a new embedding, new_embedding will be set to True, indicating that the detected face is a new representation of the player.

        # Update the player's embeddings and draw annotations based on recognition results
        if recognised:
            # The player's live embedding is updated. If the detected face is a new embedding for the player, the feature_embedding is added once again, adding to the player's existing embeddings.
            players[best_player].pop()
            if new_embedding:
                players[best_player].append(feature_embedding)  # Append the new embedding to the player's list
            players[best_player].append(feature_embedding)      # Update the player's embedding with the new one

            # Draw annotations for the recognised player
            draw_faces(frame, face, name=best_player, confidence_score=best_score, recognised=True)
        else:
            # Draw annotations for the detected face (not recognised as an existing player)
            if players:
                draw_faces(frame, face, name=best_player, confidence_score=best_score, recognised=False)

            # Add new player if the face is well defined (i.e., has a high confidence score) and is unlikely to be an existing player
            if  face[14] > 0.90 and best_score < 0.15:
                # Add new player to the players dictionary with the detected face's feature embedding. One is added to the list of embeddings for the new player and another is added as the live embedding for the player
                players[f"Player {len(players) + 1}"] = [feature_embedding] * 2
                print(f"Added new player: Player {len(players)}")

    #Display frame
    cv.imshow(win_name, frame)

    #Save frame
    mp4VideoWriter.write(frame)

#Release resources
source.release()
mp4VideoWriter.release()
cv.destroyWindow(win_name)